{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false"
  },
  "RateLimiting": {
    "Enabled": true,
    "Store": "Redis",
    "FailureMode": "Open",
    "KeyPrefix": "identity:rl",
    "PolicyCacheSeconds": 30
  },
  "Observability": {
    "SlowRequestThresholdMilliseconds": 1
  },
  "ExternalAuthentication": {
    "FrontendLoginUrl": "http://localhost:5173/login",
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "DefaultRoleCode": "Viewer"
    }
  },
  "Jwt": {
    "Issuer": "Identity.Api",
    "Audience": "Identity",
    "ApplicationCode": "Identity",
    "Key": "CHANGE-THIS-DEVELOPMENT-KEY-32-CHARS-MINIMUM",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
